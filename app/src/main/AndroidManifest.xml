<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Red: solo para el sincronizado de equipo y las plantillas firmadas.
         La captura y la voz funcionan sin internet. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Notificacion fija de "Caja abierta" y avisos de estado. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Para saber que el celular se reinicio y avisar "Toca para reactivar la voz".
         NO se usa para arrancar el servicio de voz: Android 17 lo prohibe. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Verificar comprobante y leer el QR de invitacion. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- Deliberadamente ausentes: SMS, servicio de accesibilidad y
         REQUEST_IGNORE_BATTERY_OPTIMIZATIONS. Al usuario se lo guia a los ajustes. -->

    <application
        android:name=".CheckQrApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CheckQr"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CheckQr.Starting"
            android:windowSoftInputMode="adjustResize">
            <!-- Sin android:screenOrientation a proposito: Android 17 ignora
                 los bloqueos de orientacion en pantallas grandes. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Enlace profundo desde el widget al verificador de comprobantes. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="checkqr.app"
                    android:scheme="checkqr" />
            </intent-filter>
        </activity>

        <!--
          WorkManager se inicializa desde Application, porque los workers se
          inyectan con Hilt. Sin quitar este inicializador por omision, se
          crearia una instancia sin la factory de Hilt y los workers fallarian.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
